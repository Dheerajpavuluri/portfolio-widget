{
  "name": "portfolio-widget",
  "version": "0.1.0",
  "description": "Desktop widget that tracks my stock lots with live prices and combined P&L.",
  "author": "Dheeraj Pavuluri",
  "private": true,
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:electron && npm run build:renderer",
    "build:electron": "node scripts/clean.mjs dist-electron && tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.dheerajpavuluri.portfoliowidget",
    "productName": "Portfolio Widget",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance",
      "identity": null
    },
    "linux": {
      "target": [
        "dir"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
