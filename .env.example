# Copy this file to .env and fill in your own values. .env is ignored by git.
# For the packaged Mac app, put the same file in ~/Library/Application Support/portfolio-widget/.env

# Required: free key from https://finnhub.io
FINNHUB_API_KEY=

# Optional: use Claude for the Ask view instead of Ollama on this computer.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: which Ollama model answers questions when no Anthropic key is set.
# OLLAMA_MODEL=llama3.2
